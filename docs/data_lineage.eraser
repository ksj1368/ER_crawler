direction right

// ── 매치 데이터 소스 ──────────────────────────────────────────────────
group API_MATCH [color: "yellow", label: "매치 데이터 API"] {
  RANK_API  [label: "랭킹 / 유저 조회\n(초기 시드용)"]
  MATCH_API [label: "전적 / 매치 상세 조회"]
}

// ── 정적 메타데이터 소스 ──────────────────────────────────────────────
group API_META [color: "yellow", label: "정적 메타데이터 API"] {
  META_API [label: "캐릭터 / 장비 / 특성 / 지역"]
}

// ── 수집 기준점 ───────────────────────────────────────────────────────
group STATE [color: "green", label: "수집 기준점 (DB)"] {
  USER_DB [shape: "cylinder", label: "유저\n마지막 수집 위치 기록"]
}

// ── 변환 ──────────────────────────────────────────────────────────────
group TRANSFORM [color: "purple", label: "변환"] {
  TR_USER  [label: "유저 식별 및 내부 ID 매핑"]
  TR_MATCH [label: "매치 데이터 파싱"]
  TR_META  [label: "정적 데이터 정규화"]
}

// ── 원본 보관 ─────────────────────────────────────────────────────────
group RAW_STORE [color: "gray", label: "원본 보관 (S3)"] {
  S3 [shape: "cylinder", label: "매치 원본 JSON"]
}

// ── 데이터베이스 ──────────────────────────────────────────────────────
group DB [color: "blue-light", label: "데이터베이스 (MySQL)"] {
  DB_REF    [shape: "cylinder", label: "게임 기준 정보\n캐릭터 / 장비 / 특성 / 지역"]
  DB_MATCH  [shape: "cylinder", label: "매치 기본 정보\n매치 설정 · 팀 구성 · 유저 시작 상태"]
  DB_COMBAT [shape: "cylinder", label: "전투 및 결과\n전투 · 피해 · 장비 · 능력치 · MMR"]
  DB_DETAIL [shape: "cylinder", label: "행동 상세\n특성 · 크레딧 · 오브젝트 · 가젯"]
}

// ── 연결 ──────────────────────────────────────────────────────────────
USER_DB   -> RANK_API:  "활성 유저 없을 때 초기 시드"
USER_DB   -> MATCH_API: "마지막 수집 이후 신규 매치만"
RANK_API  -> TR_USER
MATCH_API -> S3:        "원본 보관"
MATCH_API -> TR_USER
TR_USER   -> USER_DB:   "신규 참여자 자동 등록 (스노우볼링)"
TR_USER   -> TR_MATCH
TR_MATCH  -> DB_MATCH
TR_MATCH  -> DB_COMBAT
TR_MATCH  -> DB_DETAIL
META_API  -> TR_META
TR_META   -> DB_REF
